---
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<button type="button" class="pdf-btn no-print" data-pdf-download>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
    <polyline points="7 10 12 15 17 10"></polyline>
    <line x1="12" y1="15" x2="12" y2="3"></line>
  </svg>
  {t.downloadPdf}
</button>

<script>
  document
    .querySelector("[data-pdf-download]")
    ?.addEventListener("click", () => window.print());
</script>

<style>
  .pdf-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    color: inherit;
    background: var(--color-bg-pill);
    border: none;
    border-radius: 999px;
    padding: 0.3em 0.7em;
    cursor: pointer;
  }

  .pdf-btn:hover {
    opacity: 0.8;
  }

  .pdf-btn svg {
    width: 1em;
    height: 1em;
  }
</style>
