---
import { ui, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section class="stack">
  <h3 class="upper">{t.titles.techStack}</h3>
  <ul class="light">
    {
      t.techStack.map((item) => (
        <li>
          <strong>{item.label}</strong> {item.value}
        </li>
      ))
    }
  </ul>
</section>
