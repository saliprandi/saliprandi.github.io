---
import { ui, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section class="skill">
  <h3 class="upper">{t.titles.languages}</h3>
  <ul class="light">
    {
      t.languages.map((item) => (
        <li>
          {item.name} <small>({item.note})</small>
        </li>
      ))
    }
  </ul>
</section>
