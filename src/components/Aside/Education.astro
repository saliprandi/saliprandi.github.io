---
import { ui, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section class="skill">
  <h3 class="upper">{t.titles.education}</h3>
  <ul class="light">
    {
      t.education.map((item) => (
        <li>
          {item.name}
          {item.note && <small>({item.note})</small>}
        </li>
      ))
    }
  </ul>
</section>
