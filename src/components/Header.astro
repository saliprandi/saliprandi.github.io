---
import LangSwitch from "./LangSwitch.astro";
import DownloadPdf from "./DownloadPdf.astro";
import type { Lang } from "../i18n/ui";

interface Props {
  author: string;
  role: string;
  lang: Lang;
}
const { author, role, lang } = Astro.props;
---

<header>
  <div class="title">
    <h1 class="upper">{author}</h1>
    <h2 class="upper light">{role}</h2>
  </div>
  <div class="actions">
    <DownloadPdf lang={lang} />
    <LangSwitch lang={lang} />
  </div>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    padding: 2em 0;
  }

  h1 {
    font-size: 2.3rem;
    margin-bottom: 0.5rem;
  }

  h2 {
    font-size: larger;
    font-weight: 400;
    margin: 0;
  }

  .actions {
    display: flex;
    align-items: flex-start;
    gap: 0.6em;
  }

  /* Screens less than 900px */
  @media only screen and (max-width: 900px) {
    header {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
    }

    .actions {
      align-items: center;
    }
  }

  /* Print */
  @media only print {
    header {
      padding: 1em 0;
    }
  }
</style>
