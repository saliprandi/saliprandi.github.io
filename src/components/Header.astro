---
interface Props {
  author: string;
  role: string;
}
const { author, role } = Astro.props;
---

<header>
  <div class="title">
    <h1 class="upper">{author}</h1>
    <h2 class="upper light">{role}</h2>
  </div>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    padding: 2em 0;
  }

  h1 {
    font-size: 2.3rem;
    margin-bottom: 0.5rem;
  }

  h2 {
    font-size: larger;
    font-weight: 400;
    margin: 0;
  }

  /* Screens less than 900px */
  @media only screen and (max-width: 900px) {
    header {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
    }
  }

  /* Print */
  @media only print {
    header {
      padding: 1em 0;
    }
  }
</style>
