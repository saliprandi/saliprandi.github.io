---
import "@fontsource-variable/montserrat";
import "../styles/global.css";
import "../styles/print.css";
import Aside from "../components/Aside/Aside.astro";
import Header from "../components/Header.astro";
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
  author?: string;
  role?: string;
  url?: string;
  description?: string;
  title?: string;
}

const { lang = "en", author = "Santiago Ignacio Aliprandi", title } =
  Astro.props;
const t = ui[lang];
const role = Astro.props.role ?? t.role;
const url = Astro.props.url ?? t.url;
const description = Astro.props.description ?? t.description;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ?? author}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="en" href="https://saliprandi.github.io/" />
    <link rel="alternate" hreflang="es" href="https://saliprandi.github.io/es/" />
    <link rel="alternate" hreflang="x-default" href="https://saliprandi.github.io/" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={author} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:title" content={author} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header author={author} role={role} lang={lang} />
    <div class="columns">
      <Aside lang={lang} />
      <slot />
    </div>
  </body>
</html>
